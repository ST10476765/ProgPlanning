using Microsoft.AspNetCore.Mvc;
using RaceDay_MVC.Models;
using System.Text.Json;

namespace RaceDay_MVC.Controllers
{
    public class DashboardController : Controller
    {//start of class

        public async Task<IActionResult> Index()
        {
            HttpClient client = new HttpClient();

            // Get all events
            var response =
                await client.GetAsync(
                    "https://localhost:7140/api/Event/all"
                );

                var json =
                await response.Content.ReadAsStringAsync();

                var events =
                JsonSerializer.Deserialize<List<Event>>(
                    json,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                  return View(events);

        }//end of index method


namespace RaceDay_MVC.Models
{
    public class DashboardEvent
    {
        public string EventName { get; set; }

        public DateTime EventDate { get; set; }

        public string PlaceOfTheEvent { get; set; }

        //Enrollment Count
        public int EnrollmentCount { get; set; }

    }
}




namespace RaceDay_MVC.Controllers
{
    public class ParticipantController : Controller
    {

        // View Profile
        //View Profile Using Session UserID
        public async Task<IActionResult> Profile()
        {
            string userId =
                HttpContext.Session.GetString("UserID");

            if (string.IsNullOrEmpty(userId))
            {
                return RedirectToAction(
                    "Login",
                    "Authe"
                );
            }

            HttpClient client = new HttpClient();

            var response =
                await client.GetAsync(
                    $"https://localhost:7140/api/Authe/profile/participant/{userId}"
                );

            var json =
                await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                TempData["Message"] = json;

                return RedirectToAction(
                    "Index",
                    "Home"
                );
            }

            var participant =
                JsonSerializer.Deserialize<Participant>(
                    json,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

            return View(participant);
        }


        // Update Profile
        [HttpPost]
        public async Task<IActionResult> Profile(Participant participant)
        {
            HttpClient client = new HttpClient();

            string url =
                $"https://localhost:7140/api/Authe/profile/participant/update?" +
                $"userId={participant.UserID}" +
                $"&age={participant.Age}" +
                $"&gender={participant.Gender}" +
                $"&cellnumber={participant.CellNumber}";

            var response =
                await client.PutAsync(url, null);

            if (response.IsSuccessStatusCode)
            {
                TempData["Message"] =
                    "Profile Updated Successfully";
            }

            return RedirectToAction("Profile");
        }
    }
}

    }// end of class

}// end of namespace


namespace RaceDay_MVC.Models
{
    public class Participant
    {
        public int ParticipantID { get; set; }

        public string ParticipantName { get; set; }

        public string CellNumber { get; set; }

        public string Email { get; set; }

        public string RaceNumber { get; set; }

        public int Age { get; set; }

        public string Gender { get; set; }

        public int UserID { get; set; }
    }
}


